# ============================================================
# Enterprise AI Knowledge Assistant — Backend Environment
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the filled-in .env to git.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ---- Application ----
APP_NAME="Enterprise AI Knowledge Assistant"
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# ---- Database ----
# On Render: use the Internal Database URL from your Render PostgreSQL service
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
# Comma-separated list of allowed frontend origins (your Vercel URL)
# e.g. https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://your-app.vercel.app

# ---- LLM Provider (OpenRouter recommended — free models available) ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-or-v1-your_openrouter_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=liquid/lfm-2.5-2.6b:free

# ---- Embedding Provider ----
# Using mock embeddings (no external API needed for free tier)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=not_needed_for_mock
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ---- Reranking Provider ----
RERANK_PROVIDER=mock
RERANK_API_KEY=not_needed_for_mock
RERANK_MODEL=rerank-english-v3.0

# ---- Storage ----
# For Render free tier, use local file storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=enterprise-rag-docs
# AWS S3 (only needed if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ---- Document Ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_MINUTE=60
