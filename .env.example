# --- Application Configuration ---
APP_NAME="Enterprise AI Knowledge Assistant"
APP_ENV=development  # development, production, testing
SECRET_KEY=replace_this_with_a_secure_random_string_for_production

# --- Database & Caching ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_rag
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
JWT_SECRET=replace_this_with_another_secure_random_string_for_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider ---
# Supported providers: openai, mock
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embedding Provider ---
# Supported providers: openai, mock
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_openai_api_key_here  # Defaults to LLM_API_KEY if not set
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1530 # text-embedding-3-small supports 1536 dims

# --- Reranking Provider ---
# Supported providers: cohere, mock
RERANK_PROVIDER=mock
RERANK_API_KEY=your_cohere_api_key_here
RERANK_MODEL=rerank-english-v3.0

# --- Storage Configuration ---
# Supported providers: local, s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=enterprise-rag-docs
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1

# --- Document Ingestion Config ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
